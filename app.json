{
  "expo": {
    "name": "FriendShip",
    "slug": "FriendShip",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "friendship",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.mikematics.friendship",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.mikematics.friendship",
      "googleServicesFile": "./google-services.json",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF"
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      "react-native-nitro-google-signin"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "053792c2-fbe0-4faf-8524-b276e1ca186d"
      }
    },
    "owner": "mikematics"
  }
}
